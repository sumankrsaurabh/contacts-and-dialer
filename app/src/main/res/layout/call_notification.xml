<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <!-- Floating Capsule Container -->
    <LinearLayout
        android:id="@+id/notification_holder"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@drawable/bg_notification_capsule"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <!-- Avatar Section -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp">

            <ImageView
                android:id="@+id/notification_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/profile_picture_call"
                tools:ignore="ContentDescription" />

            <!-- Glass Rim Overlay -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/circle_white"
                android:alpha="0.15" />
        </FrameLayout>

        <!-- Info Section -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notification_caller_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                tools:text="Sarah Johnson" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/notification_call_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.6"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    tools:text="Ongoing call" />

                <TextView
                    android:id="@+id/notification_call_status_divider"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" • "
                    android:textColor="#FFFFFF"
                    android:alpha="0.4"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <Chronometer
                    android:id="@+id/notification_chronometer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:alpha="0.6"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>

        <!-- Remote Actions (Speaker/Mute) - Visible only when ongoing -->
        <LinearLayout
            android:id="@+id/notification_remote_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/notification_toggle_mute"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/circle_white"
                android:backgroundTint="#33FFFFFF"
                android:padding="10dp"
                android:src="@drawable/mic"
                android:tint="#FFFFFF"
                tools:ignore="UseAppTint" />

            <ImageView
                android:id="@+id/notification_toggle_speaker"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/circle_white"
                android:backgroundTint="#33FFFFFF"
                android:padding="10dp"
                android:src="@drawable/volume_high"
                android:tint="#FFFFFF"
                tools:ignore="UseAppTint" />
        </LinearLayout>

        <!-- Primary Actions (Accept/Decline) -->
        <LinearLayout
            android:id="@+id/notification_actions_holder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginStart="12dp">

            <ImageView
                android:id="@+id/notification_decline_call"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/circle_red"
                android:padding="12dp"
                android:src="@drawable/end_call"
                android:tint="#FFFFFF"
                tools:ignore="UseAppTint" />

            <ImageView
                android:id="@+id/notification_accept_call"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/circle_green"
                android:padding="12dp"
                android:src="@drawable/call"
                android:tint="#FFFFFF"
                tools:ignore="UseAppTint" />

        </LinearLayout>
    </LinearLayout>
</FrameLayout>
