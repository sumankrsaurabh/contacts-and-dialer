<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/notification_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="8dp"
    android:paddingVertical="4dp">

    <!-- Capsule Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@drawable/bg_call_notification"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <!-- Avatar with Rim -->
        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp">
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/circle_white"
                android:alpha="0.1" />
            <ImageView
                android:id="@+id/notification_avatar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                android:src="@drawable/profile_picture_call"
                tools:ignore="ContentDescription" />
        </FrameLayout>

        <!-- Identity -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notification_caller_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                tools:text="Sarah Johnson" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/notification_call_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.6"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    tools:text="Ongoing call" />

                <TextView
                    android:id="@+id/notification_call_status_divider"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" • "
                    android:textColor="#FFFFFF"
                    android:alpha="0.4"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <Chronometer
                    android:id="@+id/notification_chronometer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:alpha="0.6"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>

        <!-- Actions -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginStart="8dp">

            <ImageView
                android:id="@+id/notification_decline_call"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/circle_red"
                android:padding="12dp"
                android:src="@drawable/end_call"
                android:tint="#FFFFFF"
                tools:ignore="UseAppTint" />

            <ImageView
                android:id="@+id/notification_accept_call"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/circle_green"
                android:padding="12dp"
                android:src="@drawable/call"
                android:tint="#FFFFFF"
                tools:ignore="UseAppTint" />

        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
