<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/notification_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Caller Info Section -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Caller Name -->
            <TextView
                android:id="@+id/notification_caller_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@android:color/black"
                android:textSize="18sp"
                tools:text="Caller Name" />

            <!-- Call Status -->
            <TextView
                android:id="@+id/notification_call_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@android:color/black"
                android:textSize="14sp"
                tools:text="Ringing..." />
        </LinearLayout>

        <!-- Use FrameLayout to push buttons to the right -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <!-- Call Action Buttons -->
        <LinearLayout
            android:id="@+id/notification_actions_holder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <!-- Decline Button -->
            <ImageView
                android:id="@+id/notification_decline_call"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/circle_red"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/end_call"
                android:tint="@android:color/white"
                tools:ignore="UseAppTint" />

            <!-- Accept Button -->
            <ImageView
                android:id="@+id/notification_accept_call"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/circle_green"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/call"
                android:tint="@android:color/white"
                tools:ignore="UseAppTint" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
